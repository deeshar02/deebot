#   cp .dadai/config/secrets.env.example .dadai/config/secrets.env
#
# secrets.env is gitignored and never leaves this machine.
# This file records WHICH secrets the project needs — keys only, never values.
# Add a blank key here whenever you add one to secrets.env.

